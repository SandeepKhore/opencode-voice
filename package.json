{
  "name": "opencode-voice",
  "version": "0.1.0",
  "description": "Voice input plugin for OpenCode — speak your coding instructions",
  "main": "./src/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts"
    },
    "./server": {
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "node-global-key-listener": "^0.3.0",
    "node-record-lpcm16": "^1.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "opencode",
    "voice",
    "speech-to-text",
    "plugin"
  ],
  "license": "MIT"
}
